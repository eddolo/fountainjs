            <div
              class="gl-flex"
            >
              <div
                class="gl-new-dropdown"
                data-qa-text-style="Text style"
                data-testid="text-styles"
              >
                <div
                  class="gl-new-dropdown-custom-toggle"
                  data-testid="base-dropdown-toggle"
                >
                  <button
                    aria-label="Text style Text style"
                    class="gl-w-full btn gl-button btn-default btn-sm btn-default-tertiary"
                    title="Text style"
                    type="button"
                  >


                    <span
                      class="gl-button-text gl-mr-[-2px] !gl-flex !gl-justify-between gl-w-full"
                    >
                      <span
                        class="gl-flex-grow-1 gl-text-left"
                      >
                        Text style
                      </span>

                      <svg
                        aria-hidden="true"
                        class="gl-ml-2 gl-flex-shrink-0 gl-icon s16 gl-fill-current"
                        data-testid="chevron-down-icon"
