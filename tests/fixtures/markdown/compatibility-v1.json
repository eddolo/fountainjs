{
  "version": 1,
  "standards": {
    "commonmark": "0.31.2",
    "gfm": "0.29-gfm"
  },
  "note": "Fountain-authored representative fixtures. Passing this subset is not a claim of complete CommonMark or GFM conformance.",
  "cases": [
    {
      "id": "commonmark-atx-heading",
      "source": "  ### ATX heading ###",
      "expected": {
        "topLevelTypes": ["heading"],
        "text": "ATX heading",
        "headings": [{ "level": 3, "text": "ATX heading" }],
        "codeBlocks": [],
        "links": [],
        "marks": [],
        "hardBreaks": 0
      }
    },
    {
      "id": "commonmark-setext-heading",
      "source": "Setext heading\n--------------",
      "expected": {
        "topLevelTypes": ["heading"],
        "text": "Setext heading",
        "headings": [{ "level": 2, "text": "Setext heading" }],
        "codeBlocks": [],
        "links": [],
        "marks": [],
        "hardBreaks": 0
      }
    },
    {
      "id": "commonmark-tilde-fence",
      "source": "~~~typescript extra metadata\nconst ticks = \"```\";\n~~~",
      "expected": {
        "topLevelTypes": ["code_block"],
        "text": "const ticks = \"```\";",
        "headings": [],
        "codeBlocks": [{ "language": "typescript", "text": "const ticks = \"```\";" }],
        "links": [],
        "marks": [],
        "hardBreaks": 0
      }
    },
    {
      "id": "commonmark-indented-code",
      "source": "    const indented = true;",
      "expected": {
        "topLevelTypes": ["code_block"],
        "text": "const indented = true;",
        "headings": [],
        "codeBlocks": [{ "language": "text", "text": "const indented = true;" }],
        "links": [],
        "marks": [],
        "hardBreaks": 0
      }
    },
    {
      "id": "commonmark-emphasis-autolinks-hard-break",
      "source": "Use *star emphasis*, <https://example.com/docs>, and <writer@example.com>.\\\nContinue after a hard break.",
      "expected": {
        "topLevelTypes": ["paragraph"],
        "text": "Use star emphasis, https://example.com/docs, and writer@example.com.Continue after a hard break.",
        "headings": [],
        "codeBlocks": [],
        "links": ["https://example.com/docs", "mailto:writer@example.com"],
        "marks": ["em", "link", "link"],
        "hardBreaks": 1
      }
    },
    {
      "id": "commonmark-variable-code-spans",
      "source": "Use ``code with ` tick`` and `\\literal`.",
      "expected": {
        "topLevelTypes": ["paragraph"],
        "text": "Use code with ` tick and \\literal.",
        "headings": [],
        "codeBlocks": [],
        "links": [],
        "marks": ["code", "code"],
        "hardBreaks": 0
      }
    },
    {
      "id": "commonmark-code-span-whitespace",
      "source": "` padded ` / `   `",
      "expected": {
        "topLevelTypes": ["paragraph"],
        "text": "padded /    ",
        "headings": [],
        "codeBlocks": [],
        "links": [],
        "marks": ["code", "code"],
        "hardBreaks": 0
      }
    },
    {
      "id": "commonmark-unmatched-code-run",
      "source": "```foo``bar`",
      "expected": {
        "topLevelTypes": ["paragraph"],
        "text": "```foo``bar`",
        "headings": [],
        "codeBlocks": [],
        "links": [],
        "marks": [],
        "hardBreaks": 0
      }
    },
    {
      "id": "commonmark-character-references",
      "source": "AT&amp;T &NotEqualTilde; &#35; &#x1F642; \\&copy; and `&copy;`.",
      "expected": {
        "topLevelTypes": ["paragraph"],
        "text": "AT&T ≂̸ # 🙂 &copy; and &copy;.",
        "headings": [],
        "codeBlocks": [],
        "links": [],
        "marks": ["code"],
        "hardBreaks": 0
      }
    },
    {
      "id": "commonmark-link-destinations",
      "source": "[Angle](<docs/guide)v1>) and [nested](docs/(stable)) plus [relative](guide.md 'Guide').",
      "expected": {
        "topLevelTypes": ["paragraph"],
        "text": "Angle and nested plus relative.",
        "headings": [],
        "codeBlocks": [],
        "links": ["docs/guide)v1", "docs/(stable)", "guide.md"],
        "marks": ["link", "link", "link"],
        "hardBreaks": 0
      }
    },
    {
      "id": "commonmark-link-precedence",
      "source": "[foo](not a link) and [outer [inner](docs/inner.md)](docs/outer.md).\n\n[foo]: docs/reference.md",
      "expected": {
        "topLevelTypes": ["paragraph"],
        "text": "foo(not a link) and [outer inner](docs/outer.md).",
        "headings": [],
        "codeBlocks": [],
        "links": ["docs/reference.md", "docs/inner.md"],
        "marks": ["link", "link"],
        "hardBreaks": 0
      }
    }
  ]
}
