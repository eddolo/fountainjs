      "source": "#                  foo                     \n## \n#\n### ###",
      "expected": {
        "topLevelTypes": ["heading", "heading", "heading", "heading"],
        "text": "foo",
        "headings": [
          { "level": 1, "text": "foo" },
          { "level": 2, "text": "" },
          { "level": 1, "text": "" },
          { "level": 3, "text": "" }
