{
  "name": "fountainjs-editor",
  "version": "0.3.0",
  "description": "Free modular rich-text editor library for React, Vue, Svelte, Angular, Web Components, and plain JavaScript.",
  "author": "Paolo Cappuccini",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "document-utilities": [
        "dist/document-utilities.d.ts"
      ],
      "emoji-data": [
        "dist/emoji-data.d.ts"
      ],
      "react": [
        "dist/react/index.d.ts"
      ],
      "yjs": [
        "dist/yjs/index.d.ts"
      ],
      "comments": [
        "dist/comments/index.d.ts"
      ],
      "react/comments": [
        "dist/react/comments.d.ts"
      ],
      "tracked-changes": [
        "dist/tracked-changes/index.d.ts"
      ],
      "react/tracked-changes": [
        "dist/react/tracked-changes.d.ts"
      ],
      "versions": [
        "dist/versions/index.d.ts"
      ],
      "react/versions": [
        "dist/react/versions.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./document-utilities": {
      "import": {
        "types": "./dist/document-utilities.d.ts",
        "default": "./dist/document-utilities.js"
      },
      "require": {
        "types": "./dist/document-utilities.d.cts",
        "default": "./dist/document-utilities.cjs"
      }
    },
    "./emoji-data": {
      "import": {
        "types": "./dist/emoji-data.d.ts",
        "default": "./dist/emoji-data.js"
      },
      "require": {
        "types": "./dist/emoji-data.d.cts",
        "default": "./dist/emoji-data.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./yjs": {
      "import": {
        "types": "./dist/yjs/index.d.ts",
        "default": "./dist/yjs.js"
      },
      "require": {
        "types": "./dist/yjs/index.d.cts",
        "default": "./dist/yjs.cjs"
      }
    },
    "./comments": {
      "import": {
        "types": "./dist/comments/index.d.ts",
        "default": "./dist/comments.js"
      },
      "require": {
        "types": "./dist/comments/index.d.cts",
        "default": "./dist/comments.cjs"
      }
    },
    "./react/comments": {
      "import": {
        "types": "./dist/react/comments.d.ts",
        "default": "./dist/react-comments.js"
      },
      "require": {
        "types": "./dist/react/comments.d.cts",
        "default": "./dist/react-comments.cjs"
      }
    },
    "./tracked-changes": {
      "import": {
        "types": "./dist/tracked-changes/index.d.ts",
        "default": "./dist/tracked-changes.js"
      },
      "require": {
        "types": "./dist/tracked-changes/index.d.cts",
        "default": "./dist/tracked-changes.cjs"
      }
    },
    "./react/tracked-changes": {
      "import": {
        "types": "./dist/react/tracked-changes.d.ts",
        "default": "./dist/react-tracked-changes.js"
      },
      "require": {
        "types": "./dist/react/tracked-changes.d.cts",
        "default": "./dist/react-tracked-changes.cjs"
      }
    },
    "./versions": {
      "import": {
        "types": "./dist/versions/index.d.ts",
        "default": "./dist/versions.js"
      },
      "require": {
        "types": "./dist/versions/index.d.cts",
        "default": "./dist/versions.cjs"
      }
    },
    "./react/versions": {
      "import": {
        "types": "./dist/react/versions.d.ts",
        "default": "./dist/react-versions.js"
      },
      "require": {
        "types": "./dist/react/versions.d.cts",
        "default": "./dist/react-versions.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "scripts/smoke-package.mjs",
    "scripts/check-build-budgets.mjs",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddolo/fountainjs.git"
  },
  "homepage": "https://eddolo.github.io/fountainjs/",
  "bugs": {
    "url": "https://github.com/eddolo/fountainjs/issues"
  },
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "typescript",
    "react",
    "web-components",
    "framework-agnostic",
    "extensible",
    "contenteditable",
    "markdown",
    "html",
    "mcp",
    "ai",
    "ai-editor",
    "human-in-the-loop",
    "bring-your-own-model",
    "headless",
    "collaboration",
    "crdt",
    "yjs",
    "comments",
    "annotations",
    "tracked-changes",
    "suggestion-mode",
    "review-workflow",
    "version-history",
    "document-versions",
    "accessible"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "predev": "pnpm build",
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/smoke-package.mjs",
    "test:budget": "node scripts/check-build-budgets.mjs",
    "test:browser": "playwright test",
    "test:browser:chromium": "playwright test --project=chromium",
    "test:watch": "vitest",
    "check": "pnpm build && pnpm test:package && pnpm test:budget && pnpm typecheck && pnpm test",
    "pack:check": "pnpm pack --dry-run",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "react": ">=18 <21",
    "react-dom": ">=18 <21",
    "yjs": ">=13.6 <14"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "unicode-emoji-json": "0.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "yjs": "^13.6.32"
  }
}
