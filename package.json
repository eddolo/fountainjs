  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "predev": "pnpm build",
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/smoke-package.mjs",
    "test:api": "node scripts/check-api-surface.mjs",
    "test:budget": "node scripts/check-build-budgets.mjs",
    "test:performance": "node --expose-gc scripts/check-performance-budgets.mjs",
    "test:server-runtimes": "node scripts/smoke-server-html-runtime.mjs && node scripts/check-server-html-worker.mjs",
    "test:headless": "node scripts/check-headless-boundary.mjs && tsc -p tsconfig.headless.json",
    "test:markdown-conformance": "node scripts/check-markdown-conformance.mjs",
    "test:browser": "playwright test",
    "test:browser:chromium": "playwright test --project=chromium",
    "audit:ui": "playwright test -c playwright.audit.config.ts",
    "test:lean-integration": "node scripts/test-lean-loopback.mjs",
    "test:watch": "vitest",
    "check": "pnpm build && pnpm test:api && pnpm test:package && pnpm test:server-runtimes && pnpm test:headless && pnpm test:markdown-conformance && pnpm test:budget && pnpm test:performance && pnpm typecheck && pnpm test",
    "pack:check": "pnpm pack --dry-run",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "react": ">=18 <21",
    "react-dom": ">=18 <21",
    "yjs": ">=13.6 <14"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "commonmark-spec": "0.31.2",
    "css-select": "7.0.0",
    "entities": "8.0.0",
    "jsdom": "^30.0.1",
    "miniflare": "3.20250718.3",
    "parse5": "8.0.1",
    "parse5-htmlparser2-tree-adapter": "8.0.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2",
