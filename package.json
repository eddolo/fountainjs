{
  "name": "fountainjs-editor",
  "version": "0.3.0",
  "description": "Universal, framework-independent, modular rich-text editor for building any document experience.",
  "author": "Paolo Cappuccini",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "dist/react/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddolo/fountainjs.git"
  },
  "homepage": "https://eddolo.github.io/fountainjs/",
  "bugs": {
    "url": "https://github.com/eddolo/fountainjs/issues"
  },
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "typescript",
    "react",
    "web-components",
    "framework-agnostic",
    "extensible",
    "contenteditable",
    "markdown",
    "html",
    "mcp",
    "ai",
    "ai-editor",
    "human-in-the-loop",
    "bring-your-own-model",
    "headless",
    "accessible"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:chromium": "playwright test --project=chromium",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack:check": "pnpm pack --dry-run",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "react": ">=18 <21",
    "react-dom": ">=18 <21"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
