      }
    },
    {
      "id": "gitlab-html",
      "source": "<div dir=\"auto\"><ul class=\"task-list\"><li class=\"task-list-item\"><input type=\"checkbox\" class=\"task-list-item-checkbox\" disabled> Pending</li></ul><p>Decision</p></div>",
      "response": {
        "html": "<div dir=\"auto\"><ul class=\"task-list\"><li class=\"task-list-item\"><input type=\"checkbox\" class=\"task-list-item-checkbox\" disabled=\"\" aria-label=\"Check option: Pending\"> Pending</li></ul><p>Decision</p></div>"
