+    if (!active) configuration.canSuggest = false;
+    service = new GitLabContentEditor({
+      editable,
+      describeLabels: () => '',
+      renderMarkdown: async () => ({ body: suggestionFixture.body }),
+      getSuggestionContext: () => configuration,
+      loadSuggestionSource: loader,
+    });
+    await service.setSerializedContent(suggestionFixture.source);
+    service.editor.dispatch(
+      service.editor.createTransaction().setSelection(Selection.cursor([0, 0], 0)),
+    );
+    wrapper = mountExtended(FountainCodeMenu, {
+      propsData: { contentEditor: service, disabled: !editable, configuration },
+      attachTo: document.body,
+    });
+    await settle();
+    return configuration;
+  }
