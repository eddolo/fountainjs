   # rubocop:enable Gitlab/ModuleWithInstanceVariables
 
+  # The history reader can follow a page across a rename. Use its lookup
+  # policy and restore the Git source before HTML form encoding changed it.
+  def wiki_restore_page(revision)
+    return unless page && revision.is_a?(String) && revision.match?(/\A[0-9a-f]{40}\z/)
+
+    slug = id_param
+    if Feature.enabled?(:wiki_page_history_follow_renames, container)
+      slug = Wikis::PageHistory.new(page).slug_at(revision) || slug
+    end
+
+    wiki.find_page(slug, revision, load_content: true)
+  end
+
+  # The visual form displays the parsed body and rebuilds metadata from a hash.
+  # Reuse the exact authored header when its parsed values did not change.
+  def wiki_rich_source(submitted)
+    parsed = Gitlab::WikiPages::FrontMatterParser.new(submitted).parse
+    header = if parsed.front_matter.eql?(page.front_matter)
+               page.raw_content.to_s.delete_suffix(page.content.to_s)
+             else
+               submitted.delete_suffix(parsed.content)
+             end
+
+    header + wiki_rich_body(page.content.to_s, parsed.content)
+  end
+
+  def wiki_rich_body(original, submitted)
+    return submitted if submitted.empty?
+
+    body = submitted.gsub(/\r\n?/, "\n")
+    endings = original.scan(/\r\n|[\r\n]/)
+    return body if endings.empty?
+
+    # The rich editor emits Markdown without a file terminator after typing.
+    # Keep the file's EOF convention independently of internal paragraph gaps.
+    body += "\n" if original.end_with?("\r", "\n") && !body.end_with?("\n")
+    return body.gsub("\n", endings.first) if endings.all? { |ending| ending == endings.first }
+
+    # Keep each surviving line boundary, including mixed LF/CRLF files.
+    # A newly inserted boundary follows the convention adjacent to that edit.
+    cursor = 0
+    output = +""
+    DiffMatchPatch.new.diff_main(original.gsub(/\r\n?/, "\n"), body).each do |operation, text|
+      case operation
+      when :equal
+        retained = text.gsub("\n") do
+          cursor += 1
+          endings.fetch(cursor - 1)
+        end
+        output << retained
+      when :delete
+        cursor += text.count("\n")
+      when :insert
+        output << text.gsub("\n", endings[cursor] || endings.last)
+      end
+    end
+    output
+  end
+
   def wiki_params
     params.require(:wiki).permit(:title, :content, :format, :message, :last_commit_sha)
   end
