   # rubocop:enable Gitlab/ModuleWithInstanceVariables
 
+  # The history reader can follow a page across a rename. Use its lookup
+  # policy and restore the Git source before HTML form encoding changed it.
+  def wiki_restore_page(revision)
+    return unless page && revision.is_a?(String) && revision.match?(/\A[0-9a-f]{40}\z/)
+
+    slug = id_param
+    if Feature.enabled?(:wiki_page_history_follow_renames, container)
+      slug = Wikis::PageHistory.new(page).slug_at(revision) || slug
+    end
+
+    wiki.find_page(slug, revision, load_content: true)
+  end
+
+  # The visual form displays the parsed body and rebuilds metadata from a hash.
+  # Reuse the exact authored header when its parsed values did not change.
+  def wiki_rich_source(submitted)
+    parsed = Gitlab::WikiPages::FrontMatterParser.new(submitted).parse
+    original = page.raw_content.to_s.delete_suffix(page.content.to_s)
+    metadata = parsed.front_matter
+    header = if metadata.eql?(page.front_matter)
+               original
+             elsif metadata[:title].is_a?(String) && metadata.except(:title).eql?(page.front_matter.except(:title))
+               wiki_header_with_title(original, metadata)
+             end
+
+    (header || submitted.delete_suffix(parsed.content)) + wiki_rich_body(page.content.to_s, parsed.content)
+  end
+
+  # Locate only the top-level title with Psych. Keep comments, nested keys and
+  # delimiters in their original positions; use the host parser to verify the result.
+  def wiki_header_with_title(header, metadata)
+    yaml = Gitlab::FrontMatter::PATTERN_UNTRUSTED_REGEX.match(header)&.[](:front_matter)
+    return if yaml.blank?
+
+    closing = header.lines.last
+    prefix = header.delete_suffix(closing).delete_suffix(yaml)
+    return unless header == prefix + yaml + closing
+
+    root = Psych.parse(yaml)&.root
+    return unless root.is_a?(Psych::Nodes::Mapping)
+
+    titles = root.children.each_slice(2).select { |key, _| key.is_a?(Psych::Nodes::Scalar) && key.value == 'title' }
+    title = metadata.fetch(:title)
+    quoted = title.to_json
+    if titles.empty? && root.style != Psych::Nodes::Mapping::FLOW
+      ending = yaml.end_with?("\r\n") ? "\r\n" : "\n"
+      candidates = [yaml + (' ' * root.start_column) + "title: #{quoted}" + ending]
+    elsif titles.one? && titles.first.last.is_a?(Psych::Nodes::Scalar)
+      node = titles.first.last
+      lines = yaml.lines
+      first = lines.take(node.start_line).sum(&:size) + node.start_column
+      last = lines.take(node.end_line).sum(&:size) + node.end_column
+      terminator = yaml[first...last][/\r?\n\z/] || ''
+      preferred = case node.style
+                  when Psych::Nodes::Scalar::PLAIN then title if title.match?(/\A[[:alnum:]_][[:alnum:] _.\-]*\z/)
+                  when Psych::Nodes::Scalar::SINGLE_QUOTED then "'" + title.gsub("'", "''") + "'"
+                  end
+      candidates = [preferred, quoted].compact.uniq.map { |value| yaml[0...first] + value + terminator + yaml[last..] }
+    else
+      return
+    end
+
+    candidates.each do |candidate|
+      result = prefix + candidate + closing
+      parsed = Gitlab::WikiPages::FrontMatterParser.new(result).parse
+      return result if parsed.content.empty? && parsed.front_matter.eql?(metadata)
+    end
+    nil
+  rescue Psych::SyntaxError
+    nil
+  end
+
+  def wiki_rich_body(original, submitted)
+    return submitted if submitted.empty?
+
+    body = submitted.gsub(/\r\n?/, "\n")
+    endings = original.scan(/\r\n|[\r\n]/)
+    return body if endings.empty?
+
+    # The rich editor emits Markdown without a file terminator after typing.
+    # Keep the file's EOF convention independently of internal paragraph gaps.
+    body += "\n" if original.end_with?("\r", "\n") && !body.end_with?("\n")
+    return body.gsub("\n", endings.first) if endings.all? { |ending| ending == endings.first }
+
+    # Keep each surviving line boundary, including mixed LF/CRLF files.
+    # A newly inserted boundary follows the convention adjacent to that edit.
+    cursor = 0
+    output = +""
+    DiffMatchPatch.new.diff_main(original.gsub(/\r\n?/, "\n"), body).each do |operation, text|
+      case operation
+      when :equal
+        retained = text.gsub("\n") do
+          cursor += 1
+          endings.fetch(cursor - 1)
+        end
+        output << retained
+      when :delete
+        cursor += text.count("\n")
+      when :insert
+        output << text.gsub("\n", endings[cursor] || endings.last)
+      end
+    end
+    output
+  end
+
   def wiki_params
     params.require(:wiki).permit(:title, :content, :format, :message, :last_commit_sha)
   end
